---
import Base from "../layouts/Base.astro";
import HeroScene from "../components/HeroScene.astro";
import Glyph from "../components/Glyph.astro";
import { person, datum, centriforge, shpbTool, engineering, research, code, web } from "../data/work";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const u = (p: string) => `${base}/${p}`;
---
<Base title="Edgar Mendonca · Engineer, researcher, developer" description="Edgar Mendonca is a mechanical engineer and researcher in impact mechanics and materials, now in project and engineering management in oil and gas, who builds engineering tools such as CentriForge and the Datum apps.">
  <div class="frame">

    <section class="hero" aria-labelledby="hi">
      <div>
        <p class="mono muted">{person.role}</p>
        <h1 id="hi" class="h1">Edgar Mendonca</h1>
        <p class="lead">I've always wanted to know <span class="it">how things work</span>, and why some hold up while others give way. That question has taken me through research, engineering and building tools, and it still drives everything I do.</p>
        <div class="btns">
          <a class="btn btn-solid" href="#background">See the work</a>
        </div>
      </div>
      <div class="hero-side">
        <HeroScene />
        <dl class="facts">
          <div><dt class="mono">Now</dt><dd>Project and engineering management, oil and gas (API 617 compressor packages)</dd></div>
          <div><dt class="mono">Research</dt><dd>Impact mechanics, stress waves, tube crushing, slip in nickel alloys</dd></div>
          <div><dt class="mono">Built</dt><dd>CentriForge, SHPB analysis and the Datum apps</dd></div>
          <div><dt class="mono">Education</dt><dd>MSc Advanced Engineering Materials · BE Mechanical Engineering</dd></div>
        </dl>
      </div>
    </section>

    <!-- 01 Background -->
    <div id="background" class="bar mono"><span><b>01</b> / Background</span><span class="r">From the lab to the plant</span></div>
    <section class="block" aria-label="Background">
      <div class="split">
        <h2 class="h2">Background</h2>
        <div class="prose">
          <p>I trained as a mechanical engineer and found my subject in impact: what happens inside a material in the first microseconds after it is hit. For my bachelor's thesis I crushed metal tubes to see how they fold and absorb energy, then designed and built a Split Hopkinson Pressure Bar to test materials at high strain rates, and studied how stress waves travel through bars.</p>
          <p>My master's in advanced engineering materials took me down to the grain: for my thesis I mapped slip activity in nickel alloys with high-resolution digital image correlation and EBSD. I also returned to thin-walled tubes, working out material properties from how they collapse under lateral compression.</p>
          <p>Since 2024 I have worked in oil and gas, in project and engineering management for an API 617 export gas compressor package: design review, specification compliance and coordinating the vendors behind every sub-system. Along the way I build tools for the work I do, from the SHPB analysis code to CentriForge and the Datum apps.</p>
          <div class="btns" style="margin-top:24px">
            <a class="btn btn-solid" href={person.linkedin}>LinkedIn</a>
            <a class="btn btn-line" href={person.github}>GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Research -->
    <div id="research" class="bar mono"><span><b>02</b> / Research</span><span class="r">Impact mechanics and materials</span></div>
    <section class="block" aria-label="Research">
      <div class="intro">
        <h2 class="h2">Research</h2>
        <p class="lead">Experimental and theoretical solid mechanics: how metals respond to impact, high strain rates and large deformation, and how to measure it.</p>
      </div>
      <ul class="cells c3">
        {research.map(r => (
          <li class="rbox reveal">
            <Glyph name={r.glyph} />
            <p class="mono when">{r.kind}{r.when && ` · ${r.when}`}</p>
            <h3 class="h3">{r.title}</h3>
            <p class="muted">{r.text}</p>
            <div class="links mono">{r.links.map(l => <a href={"page" in l ? u(l.page as string) : l.href}>{l.label}</a>)}</div>
          </li>
        ))}
        <li class="rbox reveal">
          <Glyph name="code" />
          <p class="mono when">Code</p>
          <h3 class="h3">Research code</h3>
          <ul class="codes">{code.map(c => <li><a href={c.href}>{c.title}</a></li>)}</ul>
        </li>
      </ul>
    </section>

    <!-- 03 Tools -->
    <div id="tools" class="bar mono"><span><b>03</b> / Tools</span><span class="r">Built from my own work</span></div>
    <section class="block" aria-label="Tools">
      <div class="intro">
        <h2 class="h2">Engineering tools</h2>
        <p class="lead">Each one started from a problem in my own work: reducing SHPB test data, and evaluating centrifugal compressors.</p>
      </div>

      <article class="feature reveal">
        <div class="txt">
          <div class="head">
            <img src={u(centriforge.icon)} alt="" width="56" height="56" />
            <div><h3 class="h3">{centriforge.name}</h3><p class="mono muted">v{centriforge.version} · Windows and browser</p></div>
          </div>
          <p><b>{centriforge.line}</b> {centriforge.about}</p>
          <ul class="dots">{centriforge.points.map(p => <li>{p}</li>)}</ul>
          <div class="tags">{centriforge.tags.map(t => <span>{t}</span>)}</div>
          <div class="links mono"><a href={centriforge.download}>Download</a><a href={centriforge.repo}>Source</a></div>
        </div>
        <div class="pic">
          <img src={u("img/centriforge/map.jpg")} alt="CentriForge performance map with surge and stonewall limits and operating cases" loading="lazy" />
          <img src={u("img/centriforge/rotor.jpg")} alt="CentriForge 3D rotor with its mode shape" loading="lazy" />
        </div>
      </article>

      <article class="feature reveal">
        <div class="txt">
          <div class="head">
            <img src={u(shpbTool.icon)} alt="" width="56" height="56" />
            <div><h3 class="h3">{shpbTool.name}</h3><p class="mono muted">Python · MATLAB app</p></div>
          </div>
          <p>{shpbTool.line} Written for the bar I designed and built; it filters the incident, reflected and transmitted pulses, converts voltage to strain and reduces them with one-dimensional wave theory.</p>
          <div class="links mono"><a href={shpbTool.python}>Python version</a><a href={shpbTool.matlab}>MATLAB app</a><a href={shpbTool.video}>Tutorial video</a><a href={u("research/shpb")}>The project</a></div>
        </div>
        <div class="pic duo">
          <img src={u("img/shpb/filtered-voltage-data.png")} alt="Filtered incident, reflected and transmitted voltage signals" loading="lazy" />
          <img src={u("img/shpb/true-stress-strain.png")} alt="True stress–strain curve from an SHPB test" loading="lazy" />
        </div>
      </article>
    </section>

    <!-- 04 Datum -->
    <div id="datum" class="bar mono"><span><b>04</b> / Datum</span><span class="r">A family of desktop apps</span></div>
    <section class="block" aria-label="Datum">
      <div class="band reveal">
        <a href={datum.site} aria-label="Datum website">
          <img class="logo light" src={u("icons/datum-logo.svg")} alt="Datum" width="220" height="41" />
          <img class="logo dark" src={u("icons/datum-logo-light.svg")} alt="Datum" width="220" height="41" />
        </a>
        <div style="display:grid;gap:12px">
          <p>Small, fast desktop apps for engineers, scientists and researchers, written from scratch in Rust with one look and one way of working. Free and open source; no accounts, no subscriptions, no telemetry, and files stay on the user's computer.</p>
          <div class="links mono"><a href={datum.site}>Datum website</a><a href={datum.repo}>Source</a></div>
        </div>
      </div>
      <ul class="cells c3">
        {datum.apps.map(a => (
          <li class="app reveal">
            <img src={u(a.icon)} alt="" width="56" height="56" loading="lazy" />
            <h3 class="h3"><a href={a.page}>{a.name}</a></h3>
            <p>{a.line}</p>
            <div class="meta mono"><span>v{a.version}</span><a href={a.page}>Page</a><a href={a.repo}>Source</a></div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 05 Engineering -->
    <div id="engineering" class="bar mono"><span><b>05</b> / Engineering</span><span class="r">Industry projects</span></div>
    <section class="block" aria-label="Engineering">
      <div class="intro">
        <h2 class="h2">Engineering projects</h2>
        <p class="lead">Rotating equipment for oil and gas: design review, compliance and coordination from specification to delivery.</p>
      </div>
      {engineering.map(e => (
        <article class="feature reveal">
          <div class="txt">
            <p class="mono when">{e.when} · {e.where}</p>
            <h3 class="h3">{e.title}</h3>
            <p>{e.text}</p>
            <ul class="dots">{e.points.map(p => <li>{p}</li>)}</ul>
            <div class="tags">{e.tags.map(t => <span>{t}</span>)}</div>
          </div>
          <div class="pic"><img src={u(e.img)} alt={`${e.title}: 3D model of the package`} loading="lazy" /></div>
        </article>
      ))}
    </section>

    <!-- 06 Web -->
    <div id="web" class="bar mono"><span><b>06</b> / Web</span><span class="r">Sites I build and maintain</span></div>
    <section class="block" aria-label="Web">
      <div class="split">
        <h2 class="h2">Websites</h2>
        <ul class="rows">
          {web.map(w => (
            <li><a class="t h3" href={w.href}>{w.title}</a><p>{w.text} <span class="mono">· {w.when}</span></p><a class="r mono ul" href={w.href}>Visit</a></li>
          ))}
        </ul>
      </div>
    </section>

  </div>
</Base>
