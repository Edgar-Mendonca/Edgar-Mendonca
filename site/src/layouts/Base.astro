---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Edgar Mendonca" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
  <meta name="theme-color" content="#F2F1EE" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0B1119" media="(prefers-color-scheme: dark)" />
  <!-- Theme: Auto (follows the system), Light or Dark, remembered on this device. Runs before paint. -->
  <script is:inline>
    (() => {
      const r = document.documentElement, q = matchMedia("(prefers-color-scheme: dark)");
      let mode = "auto";
      try { mode = localStorage.getItem("em-theme") || "auto"; } catch {}
      if (!["auto", "light", "dark"].includes(mode)) mode = "auto";
      const set = () => {
        r.dataset.theme = mode === "auto" ? (q.matches ? "dark" : "light") : mode;
        document.querySelectorAll("[data-theme-set]").forEach(b => b.setAttribute("aria-checked", String(b.dataset.themeSet === mode)));
      };
      set();
      q.addEventListener("change", set);
      addEventListener("DOMContentLoaded", set);
      addEventListener("click", e => {
        const b = e.target.closest && e.target.closest("[data-theme-set]");
        if (!b) return;
        mode = b.dataset.themeSet;
        try { localStorage.setItem("em-theme", mode); } catch {}
        set();
      });
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>import "../scripts/motion.ts";</script>
</body>
</html>
