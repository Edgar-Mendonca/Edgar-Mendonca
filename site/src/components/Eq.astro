---
// One display equation, rendered to HTML by KaTeX at build time (no script in the page).
import katex from "katex";
interface Props { tex: string; inline?: boolean }
const { tex, inline = false } = Astro.props;
const html = katex.renderToString(tex, { displayMode: !inline, throwOnError: true, output: "html" });
---
{inline ? <span set:html={html} /> : <div class="eq" set:html={html} />}
