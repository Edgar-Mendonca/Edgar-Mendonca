---
// The hero's bench: four animated scenes from the work, one after another; the tabs switch between them.
// Without JavaScript the first scene shows, finished. Driven by src/scripts/motion.ts.
import HeroScene from "./HeroScene.astro";
import SceneTrain from "./SceneTrain.astro";
import SceneWaves from "./SceneWaves.astro";
import SceneRing from "./SceneRing.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const scenes = [
  { id: "shpb", tab: "SHPB", text: "A Split Hopkinson Pressure Bar I designed and built: testing materials at 10² to 10⁴ s⁻¹.", href: `${base}/research/shpb`, link: "The study" },
  { id: "train", tab: "API 617", text: "A centrifugal compressor train coming up to speed, held off surge by its anti-surge valve.", href: `${base}/#engineering`, link: "The project" },
  { id: "waves", tab: "Stress waves", text: "A ball strikes a free bar; the pulse returns as tension, and the strain ratio gives Poisson's ratio.", href: `${base}/research/stress-waves`, link: "The study" },
  { id: "ring", tab: "Ring crush", text: "An aluminium ring crushed between plates: elastic, collapse at P₀, then strain hardening.", href: `${base}/research/lateral-compression`, link: "The study" },
];
---
<div class="bench" data-bench>
  <div class="btabs mono" role="tablist" aria-label="Animated scenes">
    {scenes.map((s, i) => (
      <button type="button" role="tab" id={`bt-${s.id}`} aria-controls={`bp-${s.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
        <span class="n">{String(i + 1).padStart(2, "0")}</span> {s.tab}<i class="fill" aria-hidden="true"></i>
      </button>
    ))}
  </div>
  <div class="bstage">
    {scenes.map((s, i) => (
      <div class="bpanel" role="tabpanel" id={`bp-${s.id}`} aria-labelledby={`bt-${s.id}`} hidden={i !== 0}>
        {s.id === "shpb" && <HeroScene />}
        {s.id === "train" && <SceneTrain />}
        {s.id === "waves" && <SceneWaves />}
        {s.id === "ring" && <SceneRing />}
        <p class="bcap">{s.text} <a href={s.href}>{s.link} →</a></p>
      </div>
    ))}
  </div>
</div>
